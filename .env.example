# Cosy Minecraft Integration Mod — environment variables
#
# The mod reads these from the process environment (System.getenv). When run through
# the Cosy platform they are injected automatically; for manual/local runs, export
# them before starting the Fabric server (e.g. `source .env` after filling this in,
# or set them in your process manager / container).
#
# Copy this file to `.env` and fill in real values. Do NOT commit `.env` or secrets.

# --- Required ---

# Identifier of the game server; used in the Cosy API request path.
COSY_GAME_SERVER_UUID=

# Secret token sent as the `Authorization` header on every request to Cosy.
COSY_CONTAINER_SECRET=

# --- Optional ---

# Base URL of the Cosy backend. Default: http://host.docker.internal:8080
COSY_BASE_URL=http://host.docker.internal:8080

# Interval (seconds) between metric pushes. Default: 2. Non-positive values are forced to 5.
COSY_METRICS_PERIOD_SECONDS=5
